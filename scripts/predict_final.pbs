######  Module commands #####
module load conda

######  Job commands go below this line #####
. deactivate
conda deactivate
conda activate /N/project/phyloML/app/Quartz/miniconda3/envs/torch

cd /N/project/phyloML/phylo-DNN
# deeper 

CONFIG_DIR=/N/project/phyloML/trained_models/configurations/small
CHECKPOINT_DIR=/N/project/phyloML/trained_models/final # /N/project/phyloML/trained_models/attn
for TAXA in 20 40 60 
    do
        for SEQDIR in hky jc lg_indel lg_gc
            do
                for model in `ls $CHECKPOINT_DIR/$SEQDIR/`
