done

echo plotting...
for TAXA in 20 40 60
do
    for SEQDIR in jc hky hky_f lg_gc lg_indel;
        do
            python plot_drf.py --dir ${SEQDIR}_$TAXA --treefile trees_$TAXA.tsv   &
            python plot_drf.py --threshold .2 --dir ${SEQDIR}_$TAXA --treefile trees_$TAXA.tsv  
    done
done


SEQDIR=lg_gc

for CHECKPOINT_DIR in /N/project/phyloML/trained_models/final #/N/project/phyloML/trained_models/attn;
do

    for model in `ls $CHECKPOINT_DIR/$SEQDIR/`;
        do python train_and_test.py \
                --checkpoint_dir $CHECKPOINT_DIR/$SEQDIR/${model}/ --summarize >> summarize_all.txt
    done

done
      
python train_and_test.py \
                --phyloformer \
                --model_path /N/project/phyloML/app/Phyloformer/models/pf.ckpt \
                    --summarize  >> summarize_all.txt
              
SEQDIR=lg_indel
python train_and_test.py \
                --predict /N/project/phyloML/data/phyloDNN/test/${SEQDIR}_$TAXA \
                --phyloformer \
                --model_path /N/project/phyloML/app/Phyloformer/models/pf_indel.ckpt \
                    --summarize  >> summarize_all.txt

for model in `ls $CHECKPOINT_DIR/lg_gc/`
    # for model in  pair1b_f64_h4 seq1_f64_h4 seq1b_f64_h4 seq1b_f64_i7_h4 seq1_f64_l21 seq1b_f64_l21 seq1_f64x2 seq1_f64 seq1b_f64_h4_i7_l21
