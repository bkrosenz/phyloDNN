            --out /N/project/phyloML/data/phyloDNN/test/lg_gc_20_long/predictions_${model} \
            --workers 10 --batch_size 1 --pin_memory;
    done


for model in seq s3cr_p3r_mae s3p3_mae row_only seq1b_f64_i7_h4 seq1_f64_h4;   
do
    for taxa in 100 80 60;
    do
    
        python train_and_test.py    \
            --predict /N/project/phyloML/data/phyloDNN/test/lg_gc_$taxa  \
            --checkpoint_dir $CHECKPOINT_DIR/lg_gc/${model}/       \
            --out /N/project/phyloML/data/phyloDNN/test/lg_gc_$taxa/predictions_${model}   \
            --workers 10 --batch_size 1 ;    
    done;
        for taxa in 20 40 60;
    do
    
        python train_and_test.py    \
            --predict /N/project/phyloML/data/phyloDNN/test/lg_gc_$taxa  \
            --checkpoint_dir $CHECKPOINT_DIR/lg_gc/${model}/       \
            --out /N/project/phyloML/data/phyloDNN/test/lg_gc_$taxa/predictions_${model}   \
            --workers 10 --batch_size 4 ;    
    done;
done
