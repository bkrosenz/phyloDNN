                #             --workers 10 --batch_size 8 --pin_memory;
                #     done
            done

        SEQDIR=hky_alpha1
        for model in `ls $CHECKPOINT_DIR/${SEQDIR}/`
            do
                python train_and_test.py \
                    --predict /N/project/phyloML/data/phyloDNN/test/hky_f_$TAXA \
                    --checkpoint_dir $CHECKPOINT_DIR/${SEQDIR}/${model}/ \
                    --out /N/project/phyloML/data/phyloDNN/test/hky_f_$TAXA/predictions_${model} \
                    --workers 10 --batch_size 4 --pin_memory;
            done
        # for model in jcnet_e hamming;
